# A common global ignore, "Icon" (for macOS Icon\r files), also matches
# this directory on case-insensitive filesystems. Keep it tracked.
!/package/icon/

# IDE settings
/.idea/

# The app's strings, built from package/i18n (just strings, ADR 0028)
/package/ui/strings-*.js

# Python bytecode (tools/)
__pycache__/

# Results from tools/compat (just compat)
/compat.jsonl
/fingerprints.jsonl
